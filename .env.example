# AI Data Engineering Copilot — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env with real credentials — it is in .gitignore.

# --- Application ---
APP_NAME=AI Data Engineering Copilot
APP_VERSION=1.0.0
DEBUG=false

# --- Database ---
# SQLite (default — fine for local dev and single-user deployments).
# For production swap to PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/copilot
DATABASE_URL=sqlite:///./data/copilot.db

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ─────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────
# Options: demo | openrouter | openai | ollama
#
# Leave LLM_PROVIDER=demo (and LLM_API_KEY empty) for fully
# offline Demo Mode — all recommendations are generated
# deterministically by Python; no network calls are made.
# ─────────────────────────────────────────────────────────────

LLM_PROVIDER=demo
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ── OpenRouter (cloud, many models) ──────────────────────────
# Get your key at https://openrouter.ai/keys
# Browse model IDs at https://openrouter.ai/models
#
# WARNING: ":free" suffix models are free but may disappear
# (HTTP 404) or be heavily rate-limited (HTTP 429) at any time.
# If a ":free" model stops working, pick another model ID from
# https://openrouter.ai/models and update LLM_MODEL below.
# For production, remove ":free" or choose a paid model.
#
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1          # auto-set if omitted
# LLM_MODEL=<model-id-from-openrouter.ai/models>     # e.g. qwen/qwen3-235b-a22b
# LLM_API_KEY=your_openrouter_key_here

# ── Direct OpenAI ─────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=<model-id>                               # e.g. gpt-4o-mini
# LLM_API_KEY=your_openai_key_here
# LLM_BASE_URL=                                      # leave empty for api.openai.com

# ── Local Ollama ──────────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=<model-id>                               # e.g. qwen2.5, llama3
# LLM_API_KEY=                                       # not needed for Ollama

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
